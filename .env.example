# Copy to .env and fill in. .env is gitignored.
# Every key here is optional - fetchers that lack a key are skipped with a warning,
# never a hard failure.

# https://fredaccount.stlouisfed.org/apikeys  (free, instant)
FRED_API_KEY=

# https://finnhub.io/register  (free tier, 60 calls/min)
FINNHUB_API_KEY=

# SEC EDGAR requires no key, but DOES require a descriptive User-Agent with a real
# contact address, per https://www.sec.gov/os/webmaster-faq#developers
# Requests without one are throttled or blocked.
SEC_USER_AGENT="TickerLake/0.1 (your.email@example.com)"

# Optional override of the data root (defaults to ./data)
# TICKERLAKE_DATA_ROOT=D:/tickerlake-data

# https://www.tiingo.com/account/api/token  (free tier ~1,000 req/day)
TIINGO_API_KEY=

# https://www.marketaux.com/account/dashboard  (free tier 100 req/day)
MARKETAUX_API_KEY=
